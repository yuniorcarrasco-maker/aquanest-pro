# Gmail Credentials para enviar PDFs
# ===================================

# Tu email de Gmail (desde donde enviar)
GMAIL_USER=tu_email@gmail.com

# Contraseña de aplicación (NO tu contraseña normal)
# Para obtenerla:
# 1. Ve a https://myaccount.google.com/apppasswords
# 2. Selecciona "Correo" y "Windows"
# 3. Copia la contraseña generada aquí
GMAIL_PASSWORD=tu_contraseña_de_aplicacion_aqui

# Email de la imprenta (destinatario)
PRINTER_EMAIL=imprenta@email.com

# Personalización del email (opcional)
EMAIL_SUBJECT=Tarjetas de Negocio AquaNest Pro - PDF para Imprimir
EMAIL_BODY=Hola,\n\nAdjunto está el PDF listo para imprimir.\n\nEspecificaciones:\n- Tamaño: 3.5" x 2"\n- Resolución: 300 DPI\n- Acabado: Mate/Brillante\n\nSaludos
